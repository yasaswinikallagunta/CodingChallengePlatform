# Django Configuration
SECRET_KEY=your-django-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=codingchallengeplatform.onrender.com,codingchallengeplatform-frontend.onrender.com,.onrender.com,localhost,127.0.0.1

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://codingchallengeplatform-frontend.onrender.com,https://codingchallengeplatform.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Code Execution Service (Judge0 - Optional)
# RapidAPI Judge0 CE:
# Set JUDGE0_API_KEY to your RapidAPI key if using RapidAPI
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com

# Local Execution Engine fallback for local development testing (True/False)
ENABLE_LOCAL_FALLBACK_EXECUTION=True
